# Set to the public canonical origin before deployment.
SITE_URL=https://alabbas.sa
# Optional server-only HTTPS webhook that accepts validated JSON enquiries.
# Without this integration the contact endpoint returns 503; it never claims delivery.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Entire portal is unavailable by default; enable only after approvals and setup.
PORTAL_ENABLED=false
# Hostinger MySQL URL. Use the provider's TLS options for non-loopback connections.
DATABASE_URL=
# Generate locally: openssl rand -base64 32. Never commit the generated value.
PORTAL_ENCRYPTION_KEY=
# At least 32 random characters. Send as Bearer authorization, never in the cron URL.
PORTAL_CRON_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep empty unless the hosting proxy is confirmed to overwrite this header.
PORTAL_TRUSTED_IP_HEADER=
